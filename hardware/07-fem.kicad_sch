(text "SKY66423-11 / EK3 868 MHz network" (at 15 15 0) (effects (font (size 2.0 2.0)) (justify left top)) (uuid "ddf6ee77-7a1f-50dc-b55d-1ebdd5a3b6e8"))
(text "FEM group DNP in standard build. Controls default LOW. No +22 dBm MCU output connection.\nStart conducted tests at -9 dBm drive; nominal FEM gain ~29 dB at 868 MHz.\nNever exceed +10 dBm input absolute maximum; verify conducted output before antenna use." (at 15 21 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "67bf2e6b-4512-5b2d-b955-b76845e74576"))
