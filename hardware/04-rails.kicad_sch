(text "TPS63900 / 3V3_AON" (at 20 18 0) (effects (font (size 2.0 2.0)) (justify left top)) (uuid "9f8f6a74-2fa1-5705-abb5-e7c61d1787e1"))
(text "SEL=0; CFG3=16.2k selects 3.3 V. CFG1=36.5k and CFG2=0 selects\n3.3 V / unlimited input-current setting for the alternate state too.\n1% configuration resistors; sampled at startup, no continuous divider load." (at 20 24 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "911f8c43-e763-5d05-88cf-700c7ae62420"))
(text "OPTIONAL / DNP FOR MINIMUM QUIESCENT CURRENT" (at 25 246 0) (effects (font (size 2.0 2.0)) (justify left top)) (uuid "94bfb696-c506-50af-8b56-3889d80f893f"))
(text "MAX17048 group is DNP by default; enable hibernate in firmware if fitted.\n10k pullups with <=100pF bus: estimated rise time 0.847us at 100kHz.\nThis I2C bus stays on board; switched peripheral connector carries power only." (at 25 252 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "96ac29c3-59c4-5144-a82e-8351bb1abe92"))
(text "Expansion power" (at 259 174 0) (effects (font (size 2.0 2.0)) (justify left top)) (uuid "05edfd31-e68e-5394-9e34-deabf6745976"))
(text "TPS22919 defaults off; QOD discharges output.\nDo not externally power 3V3_SW.\nNo GPIO connections avoids phantom power.\nPeripheral budget <=100mA during MCU TX.\nFEM is supplied directly from PACK+, not 3V3." (at 259 180 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "69af1160-4c09-531f-ac4b-5a2aae87724d"))
